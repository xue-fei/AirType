#pragma once
// 复制本文件为 include/secrets.h 后填入你的实际网络信息。
// secrets.h 已在 .gitignore 中，不会被提交。
//
// 这里填的 Wi-Fi 只是**兜底**：设备优先读 NVS 里配网保存的凭据
// （上电后连 AirMic-XXXXXX 热点，打开 http://192.168.4.1/ 配网）。
// 只有 NVS 为空、且这里的 WIFI_SSID 不是占位符时才会用上。

#define WIFI_SSID      "MyHomeWiFi"
#define WIFI_PASS      "my-wifi-password"

// PC 端 AirTypeIME 所在机器的局域网 IP。这是**编译期默认值**：
// 设备上电配网（http://192.168.4.1/）时填的 host/port 会存进 NVS 并覆盖它，
// 所以换 PC 一般不用改这里，直接重新配网即可。
// 同时记得把 AirTypeIME/config/airtype.toml 的 server.bind 改成 "0.0.0.0"。
#define AIRTYPE_HOST   "192.168.2.177"
#define AIRTYPE_PORT   8765
#define AIRTYPE_PATH   "/ws"

// 可选：固定设备 ID（留空则由 MAC 生成）
// #define AIRMIC_DEVICE_ID "airmic-01"

// ---- 状态灯（ESP32-S3 SuperMini 默认已开启板载 WS2812，无需改动）----
// 板载 WS2812 固定在 GPIO48（与板载红色状态灯共用）。
// 若改用外接单色 LED，把 AIRMIC_LED_WS2812 改成 0，灯接 GPIO2 串 330Ω 到 GND。
// 若你的板子是 ESP32-C3 SuperMini（无 GPIO48），要改成 AIRMIC_LED_WS2812=0
// 且 PIN_LED=8（板载蓝灯低电平点亮，需 AIRMIC_LED_ACTIVE_HIGH=0）。
// #define AIRMIC_LED_WS2812 1
// #define PIN_WS2812 48
