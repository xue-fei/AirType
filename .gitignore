# WorkBuddy 本地项目数据（记忆 / 会话状态），不纳入版本库
.workbuddy/

# 旁路构建输出。build.ps1 用 -OutDir 写到这些目录，避开常被宿主进程占用的
# build\bin；都是一次性的 DLL 副本，没有版本价值。
.stage_*/
AirTypeIME/platforms/windows/tsf/.stage_*/

# 状态图标 / 探针的调试截图（--status-preview 可随时重新生成）
status_preview*.bmp
status_preview*.png
lv_*.bmp
level_compare.png

# 构建日志与临时状态文件
build_err.txt
build_full.txt
log_baseline.txt

# 一次性排查脚本（本机 comtypes 加载不了 UIA 类型库，已废弃）
uia_diag.py

# 仓库里已有的通用忽略
build/
target/
*.user
.DS_Store
Thumbs.db

# 降噪验证用的音频（clean/noisy/enhanced，可由 dpdfnet_test/verify.py 重新生成）
dpdfnet_test/

# 临时测试配置与安装日志
dt_*.toml
setup_*.log
hw_test.txt
